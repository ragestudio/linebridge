{
	"name": "@linebridge/engine-neo",
	"version": "1.0.0",
	"author": "ragestudio",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": "./src/index.ts",
		"./engine": "./src/engine.ts",
		"./register": "./src/register.ts"
	},
	"scripts": {
		"install": "npm run init && npm run build",
		"init": "node-gyp configure -- -f compile_commands_json && cp build/Release/compile_commands.json . && node-gyp configure",
		"build": "./scripts/build.sh && node-gyp build",
		"clean": "node-gyp clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest"
	},
	"peerDependencies": {
		"linebridge": "workspace:*"
	},
	"dependencies": {
		"busboy": "^1.6.0",
		"cookie": "^2.0.1",
		"cookie-signature": "^1.2.2",
		"fast-json-stringify": "^7.0.1",
		"fast-querystring": "^1.1.2",
		"mime-types": "^3.0.2",
		"tseep": "^1.3.1"
	},
	"devDependencies": {
		"node-addon-api": "^8.9.2",
		"node-api-headers": "^1.9.0",
		"node-gyp": "^12.4.0",
		"tsc-alias": "^1.9.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
